{
  "name": "api-mccar",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --ext js,sql src/server.js",
    "admin": "node src/scripts/promoverAdmin.js",
    "setup": "node src/scripts/setup.js",
    "seed": "node src/scripts/seed.js",
    "test": "node --test \"tests/unidade/*.test.js\" \"tests/api/*.test.js\"",
    "test:unidade": "node --test \"tests/unidade/*.test.js\"",
    "test:api": "node --test \"tests/api/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"tests/unidade/*.test.js\" \"tests/api/*.test.js\"",
    "test:mercadopago": "node --test \"tests/mercadopago/*.test.js\"",
    "seed:vendas": "node src/scripts/seedVendas.js",
    "zip": "node src/scripts/empacotar.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mercadopago": "3.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
